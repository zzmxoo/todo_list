{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面待办",
  "version": "0.0.8",
  "identifier": "com.desktoptodo.widget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "桌面待办",
        "width": 400,
        "height": 360,
        "minWidth": 300,
        "minHeight": 200,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "center": false,
        "visible": true,
        "skipTaskbar": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/com.desktoptodo.widget/**",
          "$APPLOCALDATA/com.desktoptodo.widget/**",
          "$HOME/.desktoptodo/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
