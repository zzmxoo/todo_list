<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX 包清单模板。由 tests/build-msix.ps1 填充占位符后交给 makeappx 打包。
  最终上架时 Publisher 必须与商店后台下发的签名证书 CN 完全一致。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:win32dependencies="http://schemas.microsoft.com/appx/manifest/externaldependencies"
  IgnorableNamespaces="uap rescap win32dependencies">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <!-- 相对包根目录；构建时会复制 Assets 文件夹 -->
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <!--
      商店 / Microsoft App Installer 安装时自动检查并安装 WebView2 运行时；
      这样 MSIX 不必打包 945MB 的固定版运行时。Optional=true 让离线安装不因此失败，
      运行时缺失时由应用启动时的兜底提示处理。
      参考：win32dependencies:ExternalDependency（WebView2 是目前唯一允许的外部依赖）。
    -->
    <win32dependencies:ExternalDependency
      Name="Microsoft.WebView2"
      Publisher="CN=Microsoft Windows, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"
      MinVersion="1.1.1.1"
      Optional="true" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="desktop-todo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="{{DESCRIPTION}}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <!--
        注意：这里刻意不声明 windows.startupTask。
        应用当前的开机自启走 HKCU\...\Run，在 MSIX 包身份下会被应用虚拟化
        重定向，系统看不到；而 StartupTask API 尚未接入。因此商店版直接禁用
        开机自启（main.rs 的 has_package_identity 会拦截），避免声明与实现脱节。
        将来接入 StartupTask 后再补回扩展声明。
      -->
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust 是桌面桥应用的必需项；提交商店时需在审核说明中解释用途 -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
